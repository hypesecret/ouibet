# Copie ce fichier en .env et remplis les clés (le .env n'est jamais commité).

# Référence en direct (Pinnacle/Betfair). Gratuit : 500 crédits/mois sur https://the-odds-api.com
ODDS_API_KEY=
# Nombre max de championnats interrogés par lancement (2 crédits chacun s'ils ont des matchs)
ODDS_API_MAX_SPORTS=20

# Alertes news (--news). Clé sur https://console.anthropic.com puis `pip install anthropic`
ANTHROPIC_API_KEY=
